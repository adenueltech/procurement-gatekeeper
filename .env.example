# Copy to .env and fill in. The real .env is git-ignored and must never be committed.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/gatekeeper

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Risk policy (optional, defaults shown)
COVERAGE_RATIO_FLAG=3
DUPLICATE_WINDOW_HOURS=48
LOOKBACK_DAYS=7
